#!/usr/bin/env zsh
# macOS development setup
# Usage: zsh <(curl -fsSL https://raw.githubusercontent.com/mary-habibi-iqd/mac-setup/main/setup)

REPO_RAW="https://raw.githubusercontent.com/mary-habibi-iqd/mac-setup/main"

FORMULAE=(git gh fnm fzf eza tree zoxide zsh-completions zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search powerlevel10k)
CASKS=(iterm2 visual-studio-code rectangle firefox@developer-edition font-meslo-lg-nerd-font)

FAILED=()

title() { echo "\n$1 \033[1m$2\033[0m"; [[ -n "$3" ]] && echo "($3)"; echo; }
ok()    { echo "  \033[0;32m✔\033[0m $1"; }
fail()  { echo "  \033[0;31m✖ $1\033[0m"; FAILED+=("$1"); }


# Checks
if [[ "$(uname)" != "Darwin" ]]; then
  echo "This script only works on macOS."
  exit 1
fi


# Install Homebrew
title "🍺" "Installing Homebrew…" "that's a package manager for macOS"

if [[ "$(uname -m)" == "arm64" ]]; then
  HOMEBREW_PREFIX="/opt/homebrew"
else
  HOMEBREW_PREFIX="/usr/local"
fi

if [[ -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
  ok "Homebrew is already installed"
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [[ ! -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
  echo "\033[0;31mHomebrew could not be installed. Please check the error above and run this script again.\033[0m"
  exit 1
fi

# Add Homebrew to PATH (only once)
if ! grep -qs "brew shellenv" ~/.zprofile; then
  echo '\n# Set PATH, MANPATH, etc., for Homebrew.' >> ~/.zprofile
  echo "eval \"\$(${HOMEBREW_PREFIX}/bin/brew shellenv)\"" >> ~/.zprofile
fi
eval "$(${HOMEBREW_PREFIX}/bin/brew shellenv)"
brew update


# Install command line tools
title "💻" "Installing Command Line Tools…" "using the Homebrew package manager"

for x in $FORMULAE; do
  if brew list --formula $x &>/dev/null || brew install $x; then ok $x; else fail $x; fi
done


# Install macOS apps
title "🖱" "Installing macOS Apps…" "using the Homebrew package manager"

for x in $CASKS; do
  if brew list --cask $x &>/dev/null || brew install --cask $x; then ok $x; else fail $x; fi
done


# Set up node lts
title "⬢" "Installing Node LTS…" "Node is a JavaScript runtime used for local development"

eval "$(fnm env --shell zsh)"
if fnm install --lts && fnm default lts-latest && fnm use default; then
  ok "Node $(node -v)"
else
  fail "Node LTS"
fi


# Configurations
title "⚙️" "Installing configurations…" "These set up your command line to work and look nicer"

# iTerm shell integration
if curl -fsSL https://iterm2.com/shell_integration/install_shell_integration_and_utilities.sh | bash; then
  ok "iTerm shell integration"
else
  fail "iTerm shell integration"
fi

# Back up existing config files, then download the new ones
BACKUP_SUFFIX=".backup-$(date +%Y%m%d-%H%M%S)"
for f in .zshrc .p10k.zsh; do
  tmp="$(mktemp)"
  if curl -fsSL "${REPO_RAW}/configs/${f}" -o "$tmp"; then
    if [[ -f ~/$f ]]; then
      cp ~/$f ~/$f$BACKUP_SUFFIX
      echo "  Backed up your old ~/$f to ~/$f$BACKUP_SUFFIX"
    fi
    mv "$tmp" ~/$f
    ok "~/$f"
  else
    rm -f "$tmp"
    fail "~/$f (download failed)"
  fi
done


# Summary
if (( ${#FAILED} )); then
  echo "\n⚠️  \033[1mDone, but some steps failed:\033[0m"
  for x in $FAILED; do echo "  \033[0;31m✖ $x\033[0m"; done
  echo "\nRead the error messages above, fix the problem and run the script again."
  echo "Steps that already worked will be skipped.\n"
  exit 1
fi

echo "\n✨ \033[1m…all done!\033[0m"
echo "You can now switch to the iTerm Terminal by pressing \033[1m⌘\033[0m + \033[1mSpace\033[0m and search for \"iTerm\".\n"
echo "Next, set up git and GitHub by running:"
echo "\033[0;36mzsh <(curl -fsSL ${REPO_RAW}/setup-git)\033[0m\n"
echo "We have some suggestions for nicer macOS settings which you can apply by running:"
echo "\033[0;36mzsh <(curl -fsSL ${REPO_RAW}/setup-macos)\033[0m\n"
